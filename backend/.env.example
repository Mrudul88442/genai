# ConstructAI Backend Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database configuration (SQLite for local, PostgreSQL for production)
DATABASE_URL=sqlite:///./constructai.db

# JWT Authentication
SECRET_KEY=constructai-super-secret-production-key-change-in-prod-2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration
# Supported: gemini, mock
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Weather Service (Open-Meteo works without key; or configure OpenWeatherMap)
WEATHER_PROVIDER=open-meteo
OPENWEATHER_API_KEY=
